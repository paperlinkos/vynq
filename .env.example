# Port for the local VYNQ application server.
PORT=4173

# Folder for persisted meeting metadata. Keep it outside source control.
VYNQ_DATA_DIR=.vynq-data

# Lifetime of a meeting after creation. Expired meetings cannot be joined.
VYNQ_MEETING_TTL_HOURS=24

# How long an approved participant can reconnect without being removed from presence.
# The browser sends a heartbeat every 10 seconds; 45 seconds is the recommended grace period.
VYNQ_PRESENCE_GRACE_SECONDS=45

# Required for a durable shared/Vercel beta. Use your Neon pooled connection URL.
DATABASE_URL=

# LiveKit configuration — all three are required to enable real audio/video.
# Never expose LIVEKIT_API_SECRET in browser code or client-visible configuration.
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Telegram integration — all values are server-only.
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEB_APP_URL=https://your-vynq-domain.example
TELEGRAM_WEBHOOK_SECRET=choose_a_long_random_secret
# Public username from BotFather, without @. Used only in setup/documentation and never as authentication.
TELEGRAM_BOT_USERNAME=your_vynq_bot

# Optional beta capacity. Includes people waiting for admission. Valid range: 2–100.
VYNQ_MAX_PARTICIPANTS=25
