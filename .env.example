# Port for the local VYNQ application server.
PORT=4173

# Folder for persisted meeting metadata. Keep it outside source control.
VYNQ_DATA_DIR=.vynq-data

# Lifetime of a meeting after creation. Expired meetings cannot be joined.
VYNQ_MEETING_TTL_HOURS=24

# Required for durable Vercel deployments. Use your Neon pooled connection URL.
DATABASE_URL=

# LiveKit configuration — required to enable real audio/video in Phase 3.
# Never expose LIVEKIT_API_SECRET in browser code or client-visible configuration.
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Telegram integration — all values are server-only.
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEB_APP_URL=https://your-vynq-domain.example
TELEGRAM_WEBHOOK_SECRET=choose_a_long_random_secret
